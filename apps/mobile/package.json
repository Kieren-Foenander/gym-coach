{
  "name": "gym-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "dev:client": "APP_VARIANT=development expo start --dev-client --scheme gym-dev",
    "ios": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android",
    "eas:ios:dev": "eas build --profile development -p ios",
    "eas:ios:preview": "eas build --profile preview -p ios",
    "eas:ios:prod": "eas build --profile production -p ios",
    "eas:android:dev": "eas build --profile development -p android",
    "config:dev": "APP_VARIANT=development expo config",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.28",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.4",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "expo-widgets": "~58.0.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
