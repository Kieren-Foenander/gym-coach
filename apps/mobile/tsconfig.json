{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["../../src/*"]
    }
  },
  "include": ["index.ts", "app.config.ts", "vitest.config.mts", "src", "test", "*.d.ts"]
}
